# Copy to .env (repo root). Docker Compose reads that file automatically for
# every `docker compose ...` command run from here -- it is NOT the app's own
# config (that's server/.env). It exists solely to satisfy variable
# interpolation.
#
# docker-compose.yml's optional "app" service (--profile full) requires
# JWT_SECRET / JWT_REFRESH_SECRET / SEED_ADMIN_PASSWORD via ${VAR:?err}.
# Compose validates required vars for the *whole file* up front, even when
# you only target the "postgres" service (e.g. `docker compose up -d
# postgres`) and never start "app" at all -- so without these set, that
# command fails before it can even reach postgres, independent of --profile
# or which service you actually asked for.
#
# The placeholders below are inert: nothing reads them unless you actually
# run `docker compose --profile full up`, in which case override them with
# real long-random values (do not use these placeholders in that case).
JWT_SECRET=local-only-placeholder-not-used-by-postgres-service
JWT_REFRESH_SECRET=local-only-placeholder-not-used-by-postgres-service
SEED_ADMIN_PASSWORD=local-only-placeholder-not-used-123456
