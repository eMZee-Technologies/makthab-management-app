environment         = "staging"
aws_region          = "us-east-1"
availability_zones  = ["us-east-1a", "us-east-1b"]
vpc_cidr            = "10.20.0.0/16"
db_instance_class   = "db.t4g.micro"
db_name             = "makthab"
db_username         = "makthab"
# db_password       = "set-via-TF_VAR_db_password or -var"
# jwt_secret        = "..."
# jwt_refresh_secret = "..."
desired_count       = 1
use_nat_gateway     = false
