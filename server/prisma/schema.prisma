// Makthab v2 — Prisma schema (single source of truth for all models).
// Derived from Madrasa_React_TS_Architecture.docx §7.1 plus a User/auth model.
//
// This is the CANONICAL schema — PostgreSQL is the primary/production
// target. `server/prisma/sqlite/schema.prisma` is GENERATED from this file
// (via `npm run db:generate:sqlite-schema -w server`) for local dev/tests;
// do not hand-edit it. See docs/architecture/redesign/01-multi-database-support.md
// for the full rationale (§2.2 "Option A").

generator client {
  provider      = "prisma-client-js"
  output        = "./generated/postgres-client"
  // "native" keeps local dev (Windows/macOS) working. debian-openssl-3.0.x is
  // required by this repo's own node:20-bookworm-slim Dockerfile — confirmed
  // by actually booting the container; Prisma silently generates only for the
  // build host's target unless every deploy target is listed explicitly.
  // linux-arm64/musl-openssl-3.0.x cover the separate ARM/Alpine deployment
  // platform this was also deployed to.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id             Int       @id @default(autoincrement())
  admissionNo    String    @unique
  fullName       String
  fatherName     String
  dateOfBirth    DateTime?
  gender         String
  contactNo      String
  whatsappNo     String
  address        String?
  classId        Int
  categoryId     Int?
  academicYearId Int
  photoPath      String?
  notes          String? // free-text: occupation, school name, previous studies, etc.
  legacyBillNo   String? // original Google Sheet bill number, preserved for reference
  feeOverrideAmount Float? // manual override for monthly amount due on the Defaulters page (arrears)
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  class        Class        @relation(fields: [classId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  feePayments  FeePayment[]
  attendance   Attendance[]

  @@index([classId])
  @@index([categoryId])
  @@index([academicYearId])
  @@index([status])
}

model FeePayment {
  id            Int      @id @default(autoincrement())
  receiptNo     String   @unique
  studentId     Int
  feeType       String
  feeMonth      Int?
  feeYear       Int
  amountDue     Float
  amountPaid    Float
  paymentDate   DateTime
  paymentMethod String
  waiverAmount  Float    @default(0)
  pdfPath       String?
  whatsappSent  Boolean  @default(false)
  collectedById Int
  createdAt     DateTime @default(now())

  student     Student @relation(fields: [studentId], references: [id])
  collectedBy Staff   @relation(fields: [collectedById], references: [id])

  @@index([studentId])
  @@index([feeYear, feeMonth])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  studentId  Int
  date       DateTime
  status     String
  notes      String?
  markedById Int
  createdAt  DateTime @default(now())

  student  Student @relation(fields: [studentId], references: [id])
  markedBy Staff   @relation(fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([date])
}

model Expense {
  id              Int      @id @default(autoincrement())
  voucherNo       String   @unique
  categoryId      Int
  cost            Float?
  quantity        Float?
  amount          Float
  expenseDate     DateTime
  payee           String
  description     String?
  receiptScanPath String?
  approvedById    Int
  createdAt       DateTime @default(now())

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  approvedBy Staff           @relation(fields: [approvedById], references: [id])

  @@index([categoryId])
  @@index([expenseDate])
}

// Voluntary contribution / donation receipt (income). Receipt numbers are
// CON-<dd-mm-yyyy>-<seq> (seq is a global 4-digit serial among CON receipts).
// Gated by the existing fees resource permissions (fees.view/create/update/delete).
model Contribution {
  id              Int      @id @default(autoincrement())
  amount          Float
  contributorName String
  contributorType String // individual | anonymous
  date            DateTime
  receiptNo       String   @unique
  notes           String?
  whatsappNo      String?
  pdfPath         String?
  whatsappSent    Boolean  @default(false)
  recordedById    Int
  createdAt       DateTime @default(now())

  recordedBy Staff @relation(fields: [recordedById], references: [id])

  @@index([date])
}

model Staff {
  id           Int      @id @default(autoincrement())
  fullName     String
  role         String
  baseSalary   Float
  contactNo    String
  whatsappNo   String
  address      String?
  photoPath    String?
  signaturePath String?
  status       String   @default("active")
  createdAt    DateTime @default(now())

  user                   User?
  salaries               SalaryPayment[]
  feesCollected          FeePayment[]
  attendanceMarked       Attendance[]
  expensesApproved       Expense[]
  contributionsRecorded  Contribution[]
  classesTaught          Class[]
}

// Application login account. Every user is linked to a Staff record (the actor
// referenced by FeePayment.collectedBy, Attendance.markedBy, Expense.approvedBy).
//
// status: active | inactive | pending_verification | pending_approval | rejected
// Self-signup accounts start pending_verification → pending_approval → active
// (after admin approve). Admin-provisioned accounts are created as active.
model User {
  id                  Int       @id @default(autoincrement())
  username            String    @unique
  passwordHash        String
  email               String?   @unique // optional when registering with phone only
  phone               String?   @unique // E.164-ish digits; optional when email-only
  role                String // role NAME (DB-backed Role.name)
  staffId             Int       @unique
  status              String    @default("active")
  otpMethod           String? // email | sms — preferred channel for OTP
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mfaEnabled          Boolean   @default(false) // Phase 2: optional TOTP
  mfaSecret           String? // encrypted TOTP secret (unused until MFA ships)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  staff              Staff                @relation(fields: [staffId], references: [id])
  otpChallenges      OtpChallenge[]
  passwordResets     PasswordResetToken[]
  refreshSessions    RefreshSession[]
  approvalSubjectOf  UserApprovalAudit[]  @relation("ApprovalSubject")
  approvalActorOf    UserApprovalAudit[]  @relation("ApprovalActor")
  notifications      AdminNotification[]
  rolePermissionAudits RolePermissionAudit[]
  auditLogs          AuditLog[]
}

// Server-side refresh-token session (Phase 3 security). Each issued refresh
// JWT carries `jti` matching RefreshSession.id. Revoked or missing rows make
// /auth/refresh fail even if the JWT signature/expiry are still valid —
// enabling logout, password-reset, and admin force-logout.
model RefreshSession {
  id        String    @id // jti (cuid)
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

// One-time passcode challenge for signup verification and password reset.
// codeHash is bcrypt of the 6-digit code; never store plaintext OTPs.
model OtpChallenge {
  id          String    @id // cuid
  userId      Int?
  purpose     String // signup | password_reset
  channel     String // email | sms
  destination String // email address or phone the OTP was sent to
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([destination, purpose])
  @@index([userId])
}

// Short-lived token issued after a successful password_reset OTP verify.
model PasswordResetToken {
  id         String    @id // cuid
  userId     Int
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Immutable audit trail of admin approve/reject decisions on signup accounts.
model UserApprovalAudit {
  id             Int      @id @default(autoincrement())
  userId         Int
  actorId        Int
  action         String // approved | rejected
  reason         String?
  previousStatus String
  newStatus      String
  roleAssigned   String?
  createdAt      DateTime @default(now())

  user  User @relation("ApprovalSubject", fields: [userId], references: [id])
  actor User @relation("ApprovalActor", fields: [actorId], references: [id])

  @@index([userId])
  @@index([actorId])
  @@index([createdAt])
}

// In-app admin notifications (e.g. new signup awaiting approval). Email/SMS
// delivery is handled by the notifier adapter; this table backs the web UI.
model AdminNotification {
  id        Int       @id @default(autoincrement())
  userId    Int // admin recipient
  type      String // signup_pending | signup_approved | signup_rejected
  title     String
  body      String
  metaJson  String? // JSON blob (subjectUserId, etc.)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([createdAt])
}

model SalaryPayment {
  id             Int      @id @default(autoincrement())
  staffId        Int
  salaryMonth    Int
  salaryYear     Int
  grossAmount    Float
  deductions     Float    @default(0)
  netAmount      Float
  paymentDate    DateTime
  payslipPdfPath String?
  whatsappSent   Boolean  @default(false)
  createdAt      DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, salaryMonth, salaryYear])
}

model Class {
  id        Int    @id @default(autoincrement())
  name      String @unique
  teacherId Int?

  teacher    Staff?     @relation(fields: [teacherId], references: [id])
  students   Student[]
  categories Category[] // categories this class offers (e.g. Noorani Qaida, Hifz Quran)
}

// Global master list of study-track categories a class can offer (e.g. Noorani
// Qaida, Naazira Quran, Hifz Quran). Shared across classes; a Class picks the
// subset it offers via the implicit m2m below. A Student optionally belongs to
// one category within their class; FeeStructure can optionally vary by
// category too (categoryId: null on either means "class-wide / no category").
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  classes       Class[]
  students      Student[]
  feeStructures FeeStructure[]
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  students       Student[]
  feeStructures  FeeStructure[]
}

model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  expenses Expense[]
}

// Fee amount per class (+ optional category) + academic year (backs GET/POST
// /fees/structures). categoryId: null means the amount applies class-wide,
// regardless of category — that's the fallback when no category-specific row
// exists (see fees.ts structFor()).
model FeeStructure {
  id             Int    @id @default(autoincrement())
  classId        Int
  categoryId     Int?
  academicYearId Int
  feeType        String
  amount         Float

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@unique([classId, categoryId, academicYearId, feeType])
}

// Institution letterhead (name + address) printed as the header on every
// generated PDF/XLSX report. Single-row table by convention (id: 1) while the
// app is single-tenant; the seam for future multi-tenancy — add a tenantId
// FK here (or make this row the tenant record itself) and scope the lookup
// by req.tenantId instead of "the one row".
model OrgProfile {
  id              Int      @id @default(autoincrement())
  name            String
  address         String
  isActive        Boolean  @default(false)
  headerImagePath String? // web app-header background only; NOT embedded in the ASCII PDF writer
  updatedAt       DateTime @updatedAt
}

// Application role with an attached permission set. Replaces the former
// hardcoded 3-value role enum: Admin can now define new roles at runtime.
// `permissions` is JSON — either a legacy permission-key string[] OR a
// RolePermissions object (`{ mode: "all" }` / `{ mode: "matrix", ... }`);
// see @makthab/shared adapters. isSystem rows (Admin/Accountant/Teacher) are
// seeded and cannot be deleted. isFullAccess (Admin) locks full grants and
// cannot be cleared. permissionsVersion bumps when grants shrink so in-flight
// access tokens are rejected until refresh. User.role stores the role NAME.
model Role {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  permissions        String // JSON: legacy string[] OR RolePermissions object
  isSystem           Boolean  @default(false)
  isFullAccess       Boolean  @default(false) // Admin lock — always all permissions
  permissionsVersion Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  audits RolePermissionAudit[]
}

// Immutable audit trail of role permission changes (Phase 3).
// roleId is optional so rows survive role deletion (onDelete: SetNull).
model RolePermissionAudit {
  id          Int      @id @default(autoincrement())
  roleId      Int?
  actorUserId Int
  action      String // create | update | delete | reassign
  beforeJson  String? // JSON RolePermissions (null on create)
  afterJson   String? // JSON RolePermissions (null on delete)
  metaJson    String? // optional JSON (e.g. reassign target role, roleName)
  createdAt   DateTime @default(now())

  role  Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  actor User  @relation(fields: [actorUserId], references: [id])

  @@index([roleId])
  @@index([actorUserId])
  @@index([createdAt])
}

// Application-wide security / CRUD audit log (append-only from app code).
// contentHash + prevHash form a tamper-evident chain; only the retention
// purge job may delete rows older than AUDIT_LOG_RETENTION_MONTHS.
model AuditLog {
  id                String   @id // cuid — stable string ids for external refs
  timestamp         DateTime @default(now())
  userId            Int?
  action            String // login | logout | create | read | update | delete | backup | purge | ...
  entity            String // auth | student | fee | admin | role | ...
  resourceId        String? // stringified entity id (nullable for auth failures, list reads)
  ipAddress         String?
  userAgent         String?
  outcome           String // success | failure
  additionalDetails String? // redacted JSON blob
  contentHash       String // SHA-256 of canonical entry fields
  prevHash          String? // previous row contentHash (genesis = null)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([outcome])
  @@index([entity, resourceId])
  @@index([userId, timestamp])
  @@index([timestamp, outcome])
  @@index([action, timestamp])
}
