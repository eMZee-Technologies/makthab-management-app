# Copy to server/.env and adjust.
#
# IMPORTANT: DATABASE_PROVIDER and DATABASE_URL must agree.
#   sqlite  → DATABASE_URL must be file:… (relative to prisma/sqlite/schema.prisma)
#   postgresql → DATABASE_URL must be postgresql://… or postgres://…
#
# DATABASE_PROVIDER=sqlite (default) resolves DATABASE_URL as a SQLite file
# path relative to prisma/sqlite/schema.prisma, so ../../../data/madrasa.db
# points at the repo-root data/ dir. Set DATABASE_PROVIDER=postgresql and
# DATABASE_URL to a postgres:// connection string to use Postgres instead
# (see docs/architecture/redesign/01-multi-database-support.md).
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:../../../data/madrasa.db"
# --- OR use Docker Compose Postgres (port 5434, not 5432/5433 — see
# docker-compose.yml for why: those are commonly claimed by a natively
# installed Postgres service on Windows) ---
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://postgres:postgres@localhost:5434/makthab_dev"
# --- OR point at a natively installed Postgres instead of Docker — use
# whatever host/port that service is actually listening on (check with
# Get-NetTCPConnection -State Listen on Windows) ---
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/makthab_dev"
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Development placeholders are rejected when NODE_ENV=production — set long
# random values before any production / Docker deploy.
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Optional: override bootstrap passwords used by `npm run db:seed` /
# container first-boot. Required (admin) when NODE_ENV=production; must be
# ≥12 chars and must not equal the documented development defaults.
# SEED_ADMIN_PASSWORD=
# SEED_ACCOUNTANT_PASSWORD=
# SEED_TEACHER_PASSWORD=
WHATSAPP_GATEWAY=walink
# Only used when WHATSAPP_GATEWAY=business-api (server sends the receipt PDF
# directly via the Meta WhatsApp Business Cloud API instead of opening a
# wa.me chat). Requires a verified WhatsApp Business Platform account.
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_API_VERSION=v21.0
# Set to a system Chrome path if Puppeteer's bundled Chromium is unavailable.
PUPPETEER_EXECUTABLE_PATH=
# Auth / OTP (optional — when unset, OTP is logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
SIGNUP_DEFAULT_ROLE=Teacher
# File storage — omit STORAGE_BACKEND to auto-select (s3 when NODE_ENV=production,
# local filesystem otherwise). See docs/architecture/FILE_STORAGE.md.
# STORAGE_BACKEND=local
# LOCAL_UPLOAD_PATH=            # optional override of data/files
# S3_BUCKET=makthab-files-prod
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=             # optional; prefer IAM role on ECS
# AWS_SECRET_ACCESS_KEY=
# Audit log retention (months) and daily purge cron (set to "off" to disable).
# AUDIT_LOG_RETENTION_MONTHS=12
# AUDIT_LOG_PURGE_CRON=15 3 * * *
# AUDIT_LOG_VOLUME_WARN_PER_MINUTE=200
# Second factor for POST /admin/backup (required when NODE_ENV=production).
# Callers must send matching X-Makthab-Backup-Token header.
# BACKUP_INTERNAL_TOKEN=
# JSON body size limit for express.json (default 1mb).
# JSON_BODY_LIMIT=1mb
